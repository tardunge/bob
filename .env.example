# Workspace and profiles
BOB_WORKSPACE_PATH=/absolute/path/to/your/workspace
BOB_PROFILES_PATH=/absolute/path/to/your/bob-profiles
BOB_DEFAULT_PROFILE=sample

# Agent runtime. Pi is the default; Claude CLI is optional.
BOB_AGENT_HARNESS=pi
BOB_PI_BINARY=pi
BOB_CLAUDE_BINARY=claude
# Optional comma-separated Pi model picker entries.
# BOB_PI_MODELS=openai-codex/model-name
PI_CACHE_RETENTION=long

# Local speech binaries and models
BOB_WHISPER_BINARY=whisper-cli
BOB_WHISPER_MODEL_PATH=/absolute/path/to/whisper-model.bin
BOB_FFMPEG_BINARY=ffmpeg
BOB_PIPER_BINARY=piper
BOB_PIPER_MODEL_PATH=/absolute/path/to/piper-voice.onnx
# Optional binary used by profile extensions.
# BOB_CURL_BINARY=curl

# Local server. Do not use 0.0.0.0 without an authenticated reverse proxy.
BOB_HOST=127.0.0.1
BOB_PORT=5556
BOB_UI_HOST=127.0.0.1
BOB_UI_PORT=5555
# Comma-separated hostnames accepted by the Vite development server.
BOB_UI_ALLOWED_HOSTS=localhost,127.0.0.1
BOB_ALLOWED_ORIGINS=http://127.0.0.1:5555,http://localhost:5555
# BOB_API_URL=http://127.0.0.1:5556
# Optional Justfile lifecycle state and Headroom ports.
# BOB_STATE_DIR=.bob
# BOB_HEADROOM_PORT=8787
# BOB_HEADROOM_TOKEN_PORT=8788

# Optional private Tailscale Serve route to the local UI. The Just lifecycle
# adds/removes only this HTTPS port and leaves other Serve routes untouched.
# BOB_TAILSCALE_ENABLED=false
# BOB_TAILSCALE_HTTPS_PORT=8555

# Local data
DATABASE_PATH=/absolute/path/to/bob.db
# BOB_PI_SESSION_DIR=/absolute/path/to/pi-sessions

# Offline installation test: no model provider or speech process is invoked.
# BOB_TEST_MODE=offline
# BOB_TEST_TRANSCRIPT=Hello from offline test mode
